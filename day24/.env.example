RAG_DOCUMENTS_PATH=docs/rag
RAG_DATA_PATH=data/rag
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_FIXED_CHUNK_SIZE=1000
RAG_FIXED_CHUNK_OVERLAP=150
RAG_STRUCTURAL_MAX_CHUNK_SIZE=1500
RAG_STRUCTURAL_OVERLAP=150
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MAX_QUERY_LENGTH=1000
RAG_CHAT_DB_PATH=data/rag.db
RAG_WEB_PORT=8000

# Day 23 enhanced retrieval. Scores are normalized FAISS inner-product values,
# not calibrated probabilities; tune the threshold against your own corpus.
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MODEL=deepseek-flash
RAG_CANDIDATE_TOP_K=15
RAG_FINAL_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.4
# Generation is allowed only when the best final chunk reaches this cosine similarity.
# Day 23's ten answerable questions had best scores >= 0.516 with the current corpus/model.
RAG_MIN_CONTEXT_SIMILARITY=0.5
RAG_FILTER_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Insert only DEEPSEEK_API_KEY in .env for a working default configuration.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-flash
DEEPSEEK_AVAILABLE_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_TIMEOUT_SECONDS=45
CHAT_HISTORY_MESSAGES=10
